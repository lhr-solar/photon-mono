# Google OAuth client (type "Web application"). Its authorized redirect URI is
# PHOTON_MCP_BASE_URL + /auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public Photon address agents connect to. The MCP endpoint is this + /mcp.
PHOTON_MCP_BASE_URL=https://150.136.85.207.sslip.io
# Who may sign in: Google accounts and whole domains, comma-separated.
# Example: @utexas.edu,someone@gmail.com
PHOTON_MCP_ALLOWED=
# database-mcp is published on 127.0.0.1 at this port. 9000 is left for `uv run python database_mcp.py`.
DATABASE_MCP_PORT=9100
INFLUX_URL=https://influx.150.136.85.207.sslip.io
INFLUX_DB=photon
INFLUX_TOKEN=
