[Unit]
Description=Photon Telemetry and CAN Stream Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photon
Group=photon
Environment="PHOTON_HOST=0.0.0.0"
Environment="PHOTON_INGRESS_PORT=6100"
Environment="PHOTON_CLIENT_PORT=6500"
Environment="PHOTON_OBSERVER_PORT=5400"
Environment="PHOTON_VIDEO_INGRESS_PORT=6600"
Environment="PHOTON_VIDEO_CLIENT_PORT=6700"
Environment="PHOTON_DATA_DIR=/var/lib/photon/data"
ExecStart=/usr/local/bin/photon-server
Restart=always
RestartSec=3s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
