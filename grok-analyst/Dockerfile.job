# Per-job runner. Sidecar `docker run`s this image once per compute job.
# No docker CLI, no TSDB, no repo. Network is applied at run time (--network=none).
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd/grok-job ./cmd/grok-job
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/grok-job ./cmd/grok-job

FROM alpine:3.20
RUN adduser -D -H -u 65534 job 2>/dev/null || true
COPY --from=build /out/grok-job /usr/local/bin/grok-job
USER 65534:65534
WORKDIR /job
ENTRYPOINT ["/usr/local/bin/grok-job"]
