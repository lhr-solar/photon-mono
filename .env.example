# Copy to .env and fill in. The server reads this from the repo root
# (the directory above build\) and from the process working directory.
# A real environment variable overrides the same key in this file.
# Leave NOMINAL_DATASET_RID empty to keep the Nominal stream off.
# NOMINAL_DATASET_RID is a dataset RID (ri.catalog.<stack>.dataset.<uuid>),
# not a workspace RID.

NOMINAL_API_KEY=
NOMINAL_WORKSPACE_RID=
NOMINAL_DATASET_RID=
# NOMINAL_BASE_URL=https://api.gov.nominal.io/api
